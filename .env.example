# Diana AI PWA — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── AI Brain (required for chat) ─────────────────────────────────
# Diana's brain — Gemini API key (primary AI backend)
GEMINI_API_KEY=your_gemini_api_key

# ─── Database (optional — app works with in-memory fallback) ──────
# MongoDB Atlas connection string for long-term memory storage
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/diana

# ─── Supabase (optional — app has built-in defaults) ─────────────
# Override Supabase connection for conversations/messages storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# ─── Discord (optional — for cross-posting messages) ─────────────
# Diana's Discord bot token and channel
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_CHANNEL_ID=your_channel_id

# ─── CLI Auth (optional — for diana-cli and zenith endpoints) ────
DIANA_CLI_TOKEN=diana-cli-2026-auth
ZENITH_TOKEN=zenith-cli-2026
