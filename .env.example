# Diana AI PWA — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Database (optional — app works with in-memory fallback) ─────────
# MongoDB Atlas connection string for long-term memory storage
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/diana

# ─── Supabase (optional — app has built-in defaults) ─────────────────
# Override Supabase connection for conversations/messages storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# ─── AI (built-in via z-ai-web-dev-sdk) ─────────────────────────────
# No API key needed — z-ai-web-dev-sdk handles AI inference
