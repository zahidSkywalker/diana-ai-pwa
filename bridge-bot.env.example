# Echo Bridge Bot — Environment Variables
# Copy this to .env and fill in your values

# Your NEW bridge bot token (NOT Echo's token)
# Create at https://discord.com/developers/applications
BRIDGE_BOT_TOKEN=your-new-bot-token-here

# Echo's bot ID
ECHO_BOT_ID=1503694342634606682

# The #echo channel ID
DISCORD_CHANNEL_ID=1511044432873656412

# Auth token to protect the /chat endpoint (the PWA will use this)
BRIDGE_AUTH_TOKEN=echo-bridge-2026-secret

# Port for the web server
PORT=8900
